#!/usr/bin/env python3
"""Single-entry CLI for the agent loop.

Subcommands:
  status   show current pipeline state at a glance
  tick     force one state-machine step now (foreground, easy to ^C)
  halt     engage all three kill switches
  resume   reverse halt
  journal  pretty-print recent runs.sqlite events
  list     list open agent-loop issues + PRs

Designed so the user can `ssh homelab` and have a single command for any
observability or control task. Wraps the same lib functions the daemon uses.
"""
from __future__ import annotations

import argparse
import datetime as dt
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import db, gh, kill_switch  # noqa: E402
from lib.config import (  # noqa: E402
    LABEL_APPROVED,
    LABEL_HALT,
    LABEL_IN_PROGRESS,
    LABEL_NEEDS_HUMAN,
    LABEL_PROPOSAL,
    LABEL_VETO,
    OFF_HOURS_END,
    OFF_HOURS_START,
)
from lib.paths import STOP_PATH, ensure_state_dir  # noqa: E402


# ---- helpers ---------------------------------------------------------------


def _fmt_ts(ts: float) -> str:
    return dt.datetime.fromtimestamp(ts).strftime("%H:%M:%S")


def _section(title: str) -> None:
    print(f"\n\033[1m{title}\033[0m")
    print("─" * max(40, len(title)))


def _ok(s: str) -> str:
    return f"\033[32m{s}\033[0m"


def _warn(s: str) -> str:
    return f"\033[33m{s}\033[0m"


def _err(s: str) -> str:
    return f"\033[31m{s}\033[0m"


def _dim(s: str) -> str:
    return f"\033[2m{s}\033[0m"


# ---- subcommands -----------------------------------------------------------


def cmd_status(_args: argparse.Namespace) -> int:
    ensure_state_dir()
    now = dt.datetime.now()
    is_off_hours = now.hour >= OFF_HOURS_START or now.hour < OFF_HOURS_END

    _section("Loop state")
    ks = kill_switch.status()
    halted = any(ks.values())
    print(f"  Current time : {now.strftime('%Y-%m-%d %H:%M:%S %Z')}")
    print(f"  Off-hours    : {_ok('YES') if is_off_hours else _dim('no (worker gated)')}")
    print(f"  Kill: STOP   : {_err('ENGAGED') if ks['stop_file'] else _ok('clear')}  ({STOP_PATH})")
    print(f"  Kill: label  : {_err('ENGAGED') if ks['halt_label'] else _ok('clear')}  ({LABEL_HALT})")
    print(f"  Overall      : {_err('HALTED') if halted else _ok('armed')}")

    _section(f"Open issues — {LABEL_APPROVED}")
    issues = gh.list_issues(labels=[LABEL_APPROVED], state="open", limit=20)
    if not issues:
        print(_dim("  (none — worker has nothing to do)"))
    for i in issues:
        labels = ",".join(l["name"] for l in i.get("labels", []))
        print(f"  #{i['number']:>4}  {i['title'][:60]}")
        print(_dim(f"        labels: {labels}"))

    _section(f"Open issues — {LABEL_PROPOSAL} (awaiting your triage)")
    props = gh.list_issues(labels=[LABEL_PROPOSAL], state="open", limit=20)
    if not props:
        print(_dim("  (none)"))
    for i in props:
        print(f"  #{i['number']:>4}  {i['title'][:60]}")

    _section("Open agent-authored PRs")
    prs = gh.list_prs(state="open", limit=30)
    agent_prs = [p for p in prs if any(l["name"].startswith("agent:") for l in p.get("labels", []))]
    if not agent_prs:
        print(_dim("  (none)"))
    for p in agent_prs:
        labels = ",".join(l["name"] for l in p.get("labels", []))
        decision = p.get("reviewDecision") or "—"
        ci = "—"
        rolls = p.get("statusCheckRollup") or []
        if rolls:
            states = {r.get("conclusion") or r.get("status") for r in rolls}
            ci = "green" if states <= {"SUCCESS", "COMPLETED"} else "/".join(sorted(s for s in states if s))
        adds, dels = p.get("additions", 0), p.get("deletions", 0)
        print(f"  PR#{p['number']:<4} {p['title'][:55]}")
        print(_dim(f"        review={decision}  ci={ci}  diff=+{adds}/-{dels}  labels={labels}"))

    _section("Today's loop events")
    summary = db.today_summary()
    if not summary:
        print(_dim("  (no events today)"))
    else:
        width = max(len(k) for k in summary)
        for k, c in sorted(summary.items()):
            print(f"  {k:<{width}}  {c}")
    return 0


def cmd_journal(args: argparse.Namespace) -> int:
    events = db.recent(args.limit)
    for ev in reversed(events):
        ts = _fmt_ts(ev["ts"])
        phase = ev["phase"].ljust(8)
        agent = (ev.get("agent") or "").ljust(6)
        target = []
        if ev.get("issue_number"):
            target.append(f"#{ev['issue_number']}")
        if ev.get("pr_number"):
            target.append(f"PR#{ev['pr_number']}")
        tgt = " ".join(target).ljust(12)
        outcome = ev.get("outcome") or ""
        dur = f"{ev['duration_s']:.1f}s" if ev.get("duration_s") else ""
        line = f"{_dim(ts)}  {phase}  {agent}  {tgt}  {ev['action']:<8} {outcome:<20} {_dim(dur)}"
        print(line)
    return 0


def cmd_tick(_args: argparse.Namespace) -> int:
    # Lazy import: avoids loading orchestrator at status-time.
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from orchestrator import one_tick  # type: ignore

    return one_tick()


def cmd_halt(_args: argparse.Namespace) -> int:
    # 1. STOP file
    STOP_PATH.parent.mkdir(parents=True, exist_ok=True)
    STOP_PATH.write_text(f"halted at {dt.datetime.now().isoformat()}\n")
    print(_warn(f"  ✓ touched {STOP_PATH}"))

    # 2. systemctl stop the daemon (idempotent — fine if not running)
    proc = subprocess.run(
        ["systemctl", "stop", "personal-site-loop.service"],
        capture_output=True, text=True,
    )
    if proc.returncode == 0:
        print(_warn("  ✓ systemctl stop personal-site-loop.service"))
    else:
        # Don't fail the halt just because systemctl isn't there or needs sudo.
        print(_dim(f"  · systemctl stop: {proc.stderr.strip() or 'no-op'}"))

    # 3. Label is per-issue/PR; we don't auto-apply it here because that'd
    #    require picking a target. Document the option:
    print(_dim(f"  · to add {LABEL_HALT} to any issue:  gh issue edit N --add-label {LABEL_HALT}"))

    db.append(phase="halt", action="engaged", outcome="manual")
    print(_warn("\nLoop halted. Run `agents/scripts/loop resume` to re-arm."))
    return 0


def cmd_resume(_args: argparse.Namespace) -> int:
    if STOP_PATH.exists():
        STOP_PATH.unlink()
        print(_ok(f"  ✓ removed {STOP_PATH}"))
    else:
        print(_dim(f"  · {STOP_PATH} was not present"))

    ks = kill_switch.status()
    if ks["halt_label"]:
        print(_warn(f"  · {LABEL_HALT} label is still set on at least one open issue/PR; remove it manually"))

    db.append(phase="halt", action="cleared", outcome="manual")
    print(_ok("\nLoop re-armed."))
    return 0


def cmd_list(_args: argparse.Namespace) -> int:
    for label in (LABEL_APPROVED, LABEL_PROPOSAL, LABEL_IN_PROGRESS,
                  LABEL_NEEDS_HUMAN, LABEL_VETO):
        items = gh.list_issues(labels=[label], state="open", limit=20)
        prs = [p for p in gh.list_prs(state="open", limit=50)
               if any(l["name"] == label for l in p.get("labels", []))]
        if not items and not prs:
            continue
        _section(label)
        for i in items:
            print(f"  #{i['number']:>4}  {i['title']}")
        for p in prs:
            print(f"  PR#{p['number']:>4}  {p['title']}")
    return 0


# ---- entry -----------------------------------------------------------------


def main() -> int:
    p = argparse.ArgumentParser(prog="loop", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="show pipeline state").set_defaults(fn=cmd_status)
    j = sub.add_parser("journal", help="recent runs.sqlite events")
    j.add_argument("--limit", type=int, default=30)
    j.set_defaults(fn=cmd_journal)
    sub.add_parser("tick", help="force one state-machine step").set_defaults(fn=cmd_tick)
    sub.add_parser("halt", help="engage all kill switches").set_defaults(fn=cmd_halt)
    sub.add_parser("resume", help="reverse halt").set_defaults(fn=cmd_resume)
    sub.add_parser("list", help="list open loop-labeled issues/PRs").set_defaults(fn=cmd_list)

    args = p.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
