# Copy to .env on the homelab host. NEVER commit.
#
# One-time setup of CLOUDFLARE_TUNNEL_TOKEN is documented in
# infra/homelab/README.md.

# --- App secrets ---
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Cloudflare Tunnel ---
# Created in Cloudflare Zero Trust → Networks → Tunnels.
# This is the "connector token" — a JWT, not your account API key.
CLOUDFLARE_TUNNEL_TOKEN=
